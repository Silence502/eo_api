# Copier ce fichier en .env et renseigner les valeurs avant de lancer docker compose

# Base de données
MYSQL_ROOT_PASSWORD=change_me_root
DB_PASSWORD=change_me_dev

# JWT – clé Base64 URL-safe d'au moins 256 bits (32 octets)
# Générer : openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=change_me_replace_with_generated_key

# Origines autorisées par CORS (URL du frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Optionnel : none | validate | update | create-drop  (défaut : update)
# JPA_DDL_AUTO=validate
